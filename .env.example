# Copy to .env for local (non-Docker) runs. Docker Compose sets these directly.
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Async SQLAlchemy URL (asyncpg driver).
DATABASE_URL=postgresql+asyncpg://dizzchat:dizzchat@localhost:5432/dizzchat
REDIS_URL=redis://localhost:6379/0

# JSON array of allowed browser origins, e.g. ["http://localhost:3000"]. Empty = none.
# Note: credentials are only enabled for explicit origins, never for the "*" wildcard.
CORS_ALLOW_ORIGINS=[]
