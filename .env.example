# Copy to .env for local (non-Docker) runs. Docker Compose sets these directly.
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Async SQLAlchemy URL (asyncpg driver).
DATABASE_URL=postgresql+asyncpg://dizzchat:dizzchat@localhost:5432/dizzchat
REDIS_URL=redis://localhost:6379/0

# Access-token signing key. Generate a strong random value (>= 32 bytes), e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-secret-at-least-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600

# JSON array of allowed browser origins, e.g. ["http://localhost:3000"]. Empty = none.
# Note: credentials are only enabled for explicit origins, never for the "*" wildcard.
CORS_ALLOW_ORIGINS=[]
